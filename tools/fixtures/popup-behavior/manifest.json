{
  "manifest_version": 3,
  "name": "Local popup behavior check",
  "version": "1.0",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+Y" } } }
}
