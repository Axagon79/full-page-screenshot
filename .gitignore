# Pacchetti zip generati per il caricamento sul Chrome Web Store.
# Lo zip si rigenera dal codice quando serve: resta sul disco ma non va versionato.
*.zip

# Backup temporanei di immagini
*_original_*.png

# Immagini originali locali usate per la scheda dello Store
/full-page-screenshot-extension/Nuova cartella/

# Spazio di lavoro VS Code (impostazioni locali, non fa parte del codice)
*.code-workspace

# File personale estraneo al progetto
dialetto-frasi.json

# Anteprime generate dalle prove locali (rigenerabili dagli script in tools).
/tools/artifacts/
